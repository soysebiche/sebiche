# Copy to .env.local for local overrides. The public site renders without any of these.
# Without RESEND_API_KEY, the contact UI preserves the inquiry and offers a mailto fallback.

# Resend API key for /api/contact delivery (leave empty locally unless testing delivery).
RESEND_API_KEY=

# Verified Resend sender, e.g. "Sebiche <contact@example.com>"
CONTACT_FROM_EMAIL=

# Inbox that receives inquiries, e.g. contact@example.com
CONTACT_TO_EMAIL=

# Optional override for the public GA4 measurement ID (Sebiche web stream).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Analytics is enabled automatically on Vercel deployments (VERCEL=1).
