# The public site renders without environment variables.
# To deliver the internal contact form, configure Resend. Without it, the UI
# preserves the inquiry and offers a prefilled mailto fallback.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Sebiche <contact@sebiche.com>"
CONTACT_TO_EMAIL=s@sebiche.com

# Vercel Analytics is enabled automatically in Vercel deployments.

# Public GA4 measurement ID for the Sebiche web stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
